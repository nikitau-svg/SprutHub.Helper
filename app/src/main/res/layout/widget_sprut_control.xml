<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_sprut"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_widget_icon"
        android:contentDescription="@null"
        android:padding="7dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_tile" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="SprutHub"
            android:textColor="@color/sprut_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Комната"
            android:textColor="@color/sprut_text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Выключено"
            android:textColor="@color/sprut_text"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_refresh"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_widget_refresh"
        android:contentDescription="@string/widget_refresh"
        android:padding="9dp"
        android:src="@drawable/ic_widget_refresh" />
</LinearLayout>
